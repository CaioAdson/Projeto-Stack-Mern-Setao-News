# Porta da API
PORT=3001

# String de conexão do MongoDB
#  - rodando a API fora do Docker (npm run dev) usando o Mongo do docker-compose
#    (usuário/senha iguais aos do .env da raiz):
DATABASE_URL=mongodb://sertaonews:troque-esta-senha@localhost:27017/sertaonews?authSource=admin

# Segredo usado para assinar os tokens JWT (gere um valor aleatório e longo)
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# Origens autorizadas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
