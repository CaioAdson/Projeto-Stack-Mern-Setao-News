# Variáveis usadas pelo docker-compose.yml
# Copie para .env e troque os valores:  cp .env.example .env

# Usuário e senha do MongoDB (criados na primeira vez que o contêiner sobe)
MONGO_USER=sertaonews
MONGO_PASSWORD=troque-esta-senha

# Segredo do JWT: gere um valor aleatório e longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d

# Portas expostas na sua máquina (mude se alguma já estiver em uso)
FRONTEND_PORT=8080
API_PORT=3001
MONGO_PORT=27017
